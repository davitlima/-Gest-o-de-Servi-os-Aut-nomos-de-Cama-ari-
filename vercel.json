{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/page.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30
    },
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30
    },
    "api/release-due.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/page.php?page=inicio" },
    { "source": "/login.html", "destination": "/api/page.php?page=login" },
    { "source": "/cadastro.html", "destination": "/api/page.php?page=cadastro" },
    { "source": "/cadastrocliente.html", "destination": "/api/page.php?page=cadastrocliente" },
    { "source": "/cadastroautonomo.html", "destination": "/api/page.php?page=cadastroautonomo" },
    { "source": "/cadastroempresa.html", "destination": "/api/page.php?page=cadastroempresa" },
    { "source": "/perfilAutonomo.html", "destination": "/api/page.php?page=perfilAutonomo" },
    { "source": "/Meuperfil.html", "destination": "/api/page.php?page=Meuperfil" },
    { "source": "/Painelfinanceiro.html", "destination": "/api/page.php?page=Painelfinanceiro" },
    { "source": "/Agenda.html", "destination": "/api/page.php?page=Agenda" },
    { "source": "/painelmensagens.html", "destination": "/api/page.php?page=painelmensagens" },
    { "source": "/lgpd.html", "destination": "/api/page.php?page=lgpd" },
    { "source": "/src/pages/inicio.html", "destination": "/api/page.php?page=inicio" },
    { "source": "/src/pages/login.html", "destination": "/api/page.php?page=login" },
    { "source": "/src/pages/cadastro.html", "destination": "/api/page.php?page=cadastro" },
    { "source": "/src/pages/cadastrocliente.html", "destination": "/api/page.php?page=cadastrocliente" },
    { "source": "/src/pages/cadastroautonomo.html", "destination": "/api/page.php?page=cadastroautonomo" },
    { "source": "/src/pages/cadastroempresa.html", "destination": "/api/page.php?page=cadastroempresa" },
    { "source": "/src/pages/perfilAutonomo.html", "destination": "/api/page.php?page=perfilAutonomo" },
    { "source": "/src/pages/Meuperfil.html", "destination": "/api/page.php?page=Meuperfil" },
    { "source": "/src/pages/Painelfinanceiro.html", "destination": "/api/page.php?page=Painelfinanceiro" },
    { "source": "/src/pages/Agenda.html", "destination": "/api/page.php?page=Agenda" },
    { "source": "/src/pages/painelmensagens.html", "destination": "/api/page.php?page=painelmensagens" },
    { "source": "/src/pages/lgpd.html", "destination": "/api/page.php?page=lgpd" }
  ]
}



